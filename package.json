{
  "name": "@deepwhale-cn/dsh-mcp-guard",
  "version": "0.1.0",
  "description": "审计本机各客户端的 MCP server 配置：未锁版本、明文端点、自动批准危险开关、环境变量里的明文密钥",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "skill",
    "mcp",
    "security",
    "安检"
  ],
  "files": [
    "lib",
    "skill",
    "bin",
    "cordis.patch.yml",
    "tests/fixtures",
    "README.md"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-mcp-guard": "bin/cli.mjs"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-mcp-guard.git"
  },
  "homepage": "https://deepwhale.org.cn/plugins.html",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-mcp-guard/issues"
  },
  "dependencies": {
    "@deepwhale-cn/dsh-guard-core": "^0.10.1"
  }
}